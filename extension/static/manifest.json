{
  "manifest_version": 3,
  "name": "Better Focus",
  "description": "Redirect blocked sites into a short learning interrupt.",
  "version": "0.1.0",
  "action": {
    "default_title": "Better Focus",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
