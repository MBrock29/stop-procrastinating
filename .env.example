VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_URL=https://betterfocus.live
VITE_OPENAI_GENERATION_MODEL=gpt-4.1-mini

# Optional frontend analytics / internal-access flags
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
VITE_ENABLE_BYOK=false
VITE_BYOK_ACCESS_EMAILS=mbrock19@gmail.com
VITE_PREMIUM_ACCESS_EMAILS=mbrock19@gmail.com
VITE_PRO_ACCESS_EMAILS=

# Stripe public key for the frontend
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...

# Stripe secret values for backend / server-side use only
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 4 recurring Stripe prices with multi-currency support
# Products / prices:
# - Pro Monthly
# - Pro Annual
# - Premium Monthly
# - Premium Annual

STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...

# Supabase Edge Function secrets (server-side only; never prefix with VITE_)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_GENERATION_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BYOK_ENCRYPTION_KEY=
GENERATION_WORKER_SECRET=
